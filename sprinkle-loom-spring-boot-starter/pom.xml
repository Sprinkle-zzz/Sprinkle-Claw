<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>icu.sprinkle.loom</groupId>
        <artifactId>sprinkle-loom-parent</artifactId>
        <version>0.11.0</version>
    </parent>

    <artifactId>sprinkle-loom-spring-boot-starter</artifactId>
    <name>Sprinkle-Loom Spring Boot Starter</name>
    <description>Spring Boot 3.2+ auto-configuration for Sprinkle-Loom Agent SDK</description>

    <properties>
        <spring-boot.version>3.2.5</spring-boot.version>
        <reactor.version>3.6.5</reactor.version>
    </properties>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>icu.sprinkle.loom</groupId>
            <artifactId>sprinkle-loom-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>icu.sprinkle.loom</groupId>
            <artifactId>sprinkle-loom-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>icu.sprinkle.loom</groupId>
            <artifactId>sprinkle-loom-mcp</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Actuator (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer (optional) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>1.12.5</version>
            <optional>true</optional>
        </dependency>

        <!-- Reactor adapter support -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <version>${reactor.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
